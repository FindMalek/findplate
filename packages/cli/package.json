{
  "name": "findplate",
  "version": "0.1.0",
  "description": "Create a production-ready full-stack project in one command: turborepo, Next.js, oRPC, better-auth, Drizzle, shadcn, and its deploys.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "findplate": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "presets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FindMalek/findplate.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "create",
    "starter",
    "template",
    "turborepo",
    "nextjs",
    "orpc",
    "shadcn",
    "better-auth",
    "drizzle"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "bun build src/index.ts --target node --outdir dist --minify",
    "prepack": "rm -rf template presets && rsync -a --exclude node_modules --exclude .next --exclude .turbo --exclude .env ../../template/ template/ && cp -R ../../presets presets && bun run build",
    "check-types": "tsc --noEmit",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
