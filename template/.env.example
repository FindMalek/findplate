# One env file for every app. `findplate create` writes .env from this, with secrets generated.

# --- urls -------------------------------------------------------------------
# Where the Next servers reach the api (inside docker/dokploy: the api service url).
API_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
WEB_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002
# @findplate:docs
DOCS_URL=http://localhost:3003
# @end

# --- database ---------------------------------------------------------------
# Host port for the local docker postgres (pnpm db:up)
POSTGRES_PORT=5432
DATABASE_URL=postgres://acme:acme@localhost:5432/acme
# demo = seed an empty database with realistic data; none = never
SEED=demo

# --- auth (better-auth) -----------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# First admin, created or reset on every api start
ADMIN_EMAIL=admin@acme.local
ADMIN_PASSWORD=
# Optional: GitHub sign-in (callback: <DASHBOARD_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- landing page -----------------------------------------------------------
# owner/name, shows stars in the footer
GITHUB_REPO=
GITHUB_TOKEN=

# @findplate:storage
# --- storage (any S3 API: Garage, R2, AWS, MinIO) ---------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# @end

# @findplate:whatsapp
# --- whatsapp (Kapso) -------------------------------------------------------
# Connect a number in https://app.kapso.ai, then create the notification template:
#   pnpm --filter @acme/whatsapp whatsapp:setup
KAPSO_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Who notify() messages, e.g. +15551234567
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=app_notification
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# @end

# @findplate:telegram
# --- telegram bot -----------------------------------------------------------
# Token from @BotFather (/newbot), then: pnpm --filter @acme/telegram telegram:setup
# It finds the chat id after you send /start and registers the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# @end

# @findplate:email
# --- email (email-sdk + Resend) ---------------------------------------------
# Without a key, mail is skipped. Add your domain: pnpm --filter @acme/email domain example.com
RESEND_API_KEY=
EMAIL_FROM=Acme <onboarding@resend.dev>
# @end

# @findplate:ai
# --- ai (Vercel AI SDK) -----------------------------------------------------
# provider:model, provider = groq | openai | anthropic
AI_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# @end

# @findplate:databuddy
# --- analytics (Databuddy, cookieless) --------------------------------------
# Dashboard > your website > client id. Empty = no tracking.
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=
# @end

# --- turbo remote cache (optional) ------------------------------------------
TURBO_API=
TURBO_TEAM=
TURBO_TOKEN=
