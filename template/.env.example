# One env file for every app. `findplate create` writes .env from this, with secrets generated.

# --- urls -------------------------------------------------------------------
# Where the Next servers reach the api (inside docker/dokploy: the api service url).
API_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
WEB_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002

# --- database ---------------------------------------------------------------
# Host port for the local docker postgres (pnpm db:up)
POSTGRES_PORT=5432
DATABASE_URL=postgres://acme:acme@localhost:5432/acme
# demo = seed an empty database with realistic data; none = never
SEED=demo

# --- auth (better-auth) -----------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# First admin, created or reset on every api start
ADMIN_EMAIL=admin@acme.local
ADMIN_PASSWORD=
# Optional: GitHub sign-in (callback: <DASHBOARD_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- landing page -----------------------------------------------------------
# owner/name, shows stars in the footer
GITHUB_REPO=
GITHUB_TOKEN=

# @findplate:storage
# --- storage (any S3 API: Garage, R2, AWS, MinIO) ---------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# @end

# @findplate:ai
# --- ai (Vercel AI SDK) -----------------------------------------------------
# provider:model, provider = groq | openai | anthropic
AI_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# @end

# @findplate:umami
# --- analytics (Umami, self-hosted) -----------------------------------------
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# @end

# @findplate:openobserve
# --- traces (OpenObserve, self-hosted) --------------------------------------
OPENOBSERVE_URL=
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=
OPENOBSERVE_PASSWORD=
# @end

# @findplate:glitchtip
# --- errors (GlitchTip, sentry dsn from your project) -----------------------
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=
# @end

# @findplate:langfuse
# --- ai tracing (Langfuse) ---------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# @end

# --- turbo remote cache (optional) ------------------------------------------
TURBO_API=
TURBO_TEAM=
TURBO_TOKEN=
