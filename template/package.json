{
  "name": "acme",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev -F web -F api",
    "dev:dashboard": "turbo dev -F dashboard -F api",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "lint": "biome ci . && oxlint",
    "check": "biome check --write .",
    "agents": "npx --yes @intellectronica/ruler@0.3.46 apply",
    "db:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "db:generate": "turbo db:generate -F @acme/db",
    "db:migrate": "turbo db:migrate -F @acme/db",
    "db:seed": "turbo db:seed -F @acme/db",
    "db:studio": "turbo db:studio -F @acme/db",
    "ui:add": "pnpm --filter @acme/ui exec shadcn add"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@shadcn/lint": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  }
}
