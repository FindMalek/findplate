{
  "name": "@acme/notification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./templates": "./src/templates/index.ts",
    "./brand": "./src/brand.ts"
  },
  "scripts": {
