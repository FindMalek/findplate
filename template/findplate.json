{
  "$comment": "Read by the findplate cli: what each optional module owns. Code inside `@findplate:<module>` ... `@end` markers is removed when the module is off.",
  "name": "acme",
  "scope": "@acme",
  "skills": [
    {
      "source": "vercel-labs/agent-skills",
      "skills": ["vercel-react-best-practices", "vercel-composition-patterns", "web-design-guidelines"]
    },
    { "source": "shadcn/ui", "skills": ["shadcn"] },
    { "source": "vercel-labs/openreview", "skills": ["next-best-practices"] },
    { "source": "vercel/turborepo", "skills": ["turborepo"] },
    { "source": "better-auth/skills", "skills": ["better-auth-best-practices"] },
    { "source": "vercel-labs/skills", "skills": ["find-skills"] }
  ],
  "groups": {
    "product": "Product pages",
    "platform": "Platform",
    "notifications": "Notifications",
    "analytics": "Analytics",
    "ops": "Observability and secrets"
  },
  "modules": {
    "storage": {
      "label": "File storage",
      "hint": "uploads to any S3 API (Garage, R2, AWS, MinIO)",
      "group": "platform",
      "profiles": ["standard", "everything"],
      "paths": ["packages/storage"],
      "packages": ["@acme/storage"]
    },
    "webhooks": {
      "label": "Webhooks",
      "hint": "signature checks for inbound webhooks (hmac, svix, secret header)",
      "group": "platform",
      "profiles": ["everything"],
      "paths": ["packages/webhooks"],
      "packages": ["@acme/webhooks"]
    },
    "notification": {
      "label": "Notification",
      "hint": "email, Telegram and WhatsApp behind one notifier, with branded react-email templates and a preview app",
      "group": "notifications",
      "profiles": ["everything"],
      "requires": ["webhooks"],
      "paths": ["packages/notification", "packages/orpc/src/routers/notification.ts", "apps/email"],
      "packages": [
        "@acme/notification",
        "@kapso/whatsapp-cloud-api",
        "@opencoredev/email-sdk",
        "@react-email/components",
        "@react-email/render",
        "@react-email/ui",
        "react-email"
      ],
      "scripts": { "dev:email": "turbo dev -F email", "email:export": "turbo export -F email" },
      "keys": [
        { "env": "RESEND_API_KEY", "label": "Resend API key (email)", "url": "https://resend.com/api-keys" },
        {
          "env": "TELEGRAM_BOT_TOKEN",
          "label": "Telegram bot token (from @BotFather)",
          "url": "https://t.me/BotFather"
        },
        { "env": "KAPSO_API_KEY", "label": "Kapso API key (WhatsApp)", "url": "https://app.kapso.ai" }
      ]
    },
    "docs": {
      "label": "Docs site",
      "hint": "fumadocs on Next, with pages about your project",
      "group": "product",
      "profiles": ["standard", "everything"],
      "paths": ["apps/docs"],
      "packages": ["fumadocs-core", "fumadocs-mdx", "fumadocs-ui", "@types/mdx"]
    },
    "ai": {
      "label": "AI",
      "hint": "Vercel AI SDK with Groq, OpenAI or Anthropic",
      "group": "platform",
      "profiles": ["standard", "everything"],
      "paths": ["packages/ai", "apps/dashboard/components/summarize-button.tsx"],
      "packages": ["@acme/ai", "ai", "@ai-sdk/anthropic", "@ai-sdk/groq", "@ai-sdk/openai"],
      "skills": [{ "source": "vercel/ai", "skills": ["ai-sdk"] }],
      "keys": [
        { "env": "GROQ_API_KEY", "label": "Groq API key", "url": "https://console.groq.com/keys" },
        { "env": "OPENAI_API_KEY", "label": "OpenAI API key", "url": "https://platform.openai.com/api-keys" },
        {
          "env": "ANTHROPIC_API_KEY",
          "label": "Anthropic API key",
          "url": "https://console.anthropic.com/settings/keys"
        }
      ]
    },
    "umami": {
      "label": "Umami analytics",
      "hint": "self-hosted web analytics script in web and dashboard",
      "group": "analytics",
      "profiles": [],
      "server": { "label": "a self-hosted Umami server", "url": "https://umami.is/docs/install" },
      "paths": ["apps/web/components/umami.tsx", "apps/dashboard/components/umami.tsx"],
      "packages": [],
      "keys": [
        {
          "env": "NEXT_PUBLIC_UMAMI_WEBSITE_ID",
          "label": "Umami website id",
          "url": "https://umami.is/docs/add-a-website"
        }
      ]
    },
    "openobserve": {
      "label": "OpenObserve",
      "hint": "self-hosted otel traces from the api",
      "group": "ops",
      "profiles": [],
      "server": { "label": "a self-hosted OpenObserve server", "url": "https://openobserve.ai/docs/quickstart/" },
      "paths": ["apps/api/src/openobserve.ts"],
      "packages": ["@opentelemetry/api", "@opentelemetry/sdk-node", "@opentelemetry/exporter-trace-otlp-http"]
    },
    "glitchtip": {
      "label": "GlitchTip",
      "hint": "self-hosted error tracking (sentry sdk) in api, web and dashboard",
      "group": "ops",
      "profiles": [],
      "server": { "label": "a self-hosted GlitchTip server", "url": "https://glitchtip.com/documentation/install" },
      "paths": ["apps/web/instrumentation-client.ts", "apps/dashboard/instrumentation-client.ts"],
      "packages": ["@sentry/bun", "@sentry/nextjs"],
      "keys": [
        { "env": "GLITCHTIP_DSN", "label": "GlitchTip DSN", "url": "https://glitchtip.com/documentation/install" }
      ]
    },
    "infisical": {
      "label": "Infisical",
      "hint": "self-hosted secrets, dev scripts run through the infisical cli",
      "group": "ops",
      "profiles": [],
      "server": {
        "label": "a self-hosted Infisical server",
        "url": "https://infisical.com/docs/self-hosting/overview"
      },
      "paths": [".infisical.json"],
      "packages": [],
      "scripts": { "dev:secrets": "infisical run --env=dev -- turbo dev" }
    },
    "langfuse": {
      "label": "Langfuse",
      "hint": "self-hosted LLM tracing for the ai module",
      "group": "ops",
      "profiles": [],
      "server": { "label": "a self-hosted Langfuse server", "url": "https://langfuse.com/self-hosting" },
      "requires": ["ai"],
      "paths": ["apps/api/src/langfuse.ts"],
      "packages": ["@langfuse/otel", "@langfuse/vercel-ai-sdk", "@opentelemetry/sdk-node"],
      "keys": [
        {
          "env": "LANGFUSE_PUBLIC_KEY",
          "label": "Langfuse public key",
          "url": "https://langfuse.com/docs/get-started"
        },
        { "env": "LANGFUSE_SECRET_KEY", "label": "Langfuse secret key", "url": "https://langfuse.com/docs/get-started" }
      ]
    },
    "waitlist": {
      "label": "Waitlist",
      "hint": "email signup on the landing page, list in the dashboard",
      "group": "product",
      "profiles": ["everything"],
      "paths": [
        "packages/db/src/schema/waitlist.ts",
        "packages/db/drizzle/0001_waitlist.sql",
        "packages/db/drizzle/meta/0001_snapshot.json",
        "packages/orpc/src/routers/waitlist.ts",
        "apps/web/components/waitlist-form.tsx",
        "apps/dashboard/app/(app)/waitlist"
      ],
      "packages": []
    },
    "roadmap": {
      "label": "Roadmap page",
      "hint": "public /roadmap built from the repo's GitHub milestones",
      "group": "product",
      "profiles": ["everything"],
      "paths": [
        "packages/orpc/src/routers/roadmap.ts",
        "packages/orpc/src/lib/roadmap.ts",
        "packages/orpc/src/lib/roadmap.test.ts",
        "apps/web/app/roadmap"
      ],
      "packages": []
    },
    "status": {
      "label": "Status page",
      "hint": "public /status with live uptime checks of every service",
      "group": "product",
      "profiles": ["everything"],
      "paths": ["packages/orpc/src/routers/status.ts", "apps/web/app/status"],
      "packages": []
    },
    "databuddy": {
      "label": "Databuddy analytics",
      "hint": "privacy first, cookieless analytics on web and dashboard",
      "group": "analytics",
      "profiles": ["everything"],
      "paths": ["apps/web/components/analytics.tsx", "apps/dashboard/components/analytics.tsx"],
      "packages": ["@databuddy/sdk"],
      "keys": [
        { "env": "NEXT_PUBLIC_DATABUDDY_CLIENT_ID", "label": "Databuddy client id", "url": "https://app.databuddy.cc" }
      ]
    },
    "rate-limit": {
      "label": "Rate limiting",
      "hint": "per route and ip limits on the api, in memory or on Upstash Redis",
      "group": "platform",
      "profiles": ["standard", "everything"],
      "paths": [
        "apps/api/src/rate-limit.ts",
        "apps/api/src/rate-limit.test.ts",
        "packages/orpc/src/lib/rate-limit.ts",
        "packages/orpc/src/lib/rate-limit.test.ts"
      ],
      "packages": []
    },
    "mobile": {
      "label": "Mobile app",
      "hint": "an Expo app in apps/mobile with the typed api client, better-auth sign in and the notes example",
      "group": "product",
      "profiles": ["everything"],
      "paths": ["apps/mobile"],
      "packages": [
        "@better-auth/expo",
        "expo",
        "expo-constants",
        "expo-linking",
        "expo-network",
        "expo-router",
        "expo-secure-store",
        "expo-status-bar",
        "expo-web-browser",
        "react-native",
        "react-native-safe-area-context",
        "react-native-screens"
      ],
      "scripts": { "dev:mobile": "pnpm --filter mobile start" }
    },
    "blog": {
      "label": "Blog and changelog",
      "hint": "mdx posts in the web app with an rss feed, og images, sitemap entries and a changelog page",
      "group": "product",
      "profiles": ["everything"],
      "paths": [
        "apps/web/app/blog",
        "apps/web/app/changelog",
        "apps/web/content",
        "apps/web/lib/blog.ts",
        "apps/web/lib/blog.test.ts",
        "apps/web/mdx-components.tsx",
        "apps/web/types/mdx.d.ts"
      ],
      "packages": ["@next/mdx", "@mdx-js/loader", "@mdx-js/react", "@types/mdx"]
    },
    "cache": {
      "label": "Cache",
      "hint": "typed get, set, ttl and tag invalidation on Upstash Redis, in memory without it",
      "group": "platform",
      "profiles": ["everything"],
      "paths": ["packages/cache"],
      "packages": ["@acme/cache"]
    },
    "flags": {
      "label": "Feature flags",
      "hint": "typed flags with code defaults, env overrides and dashboard rollouts per user",
      "group": "platform",
      "profiles": ["everything"],
      "paths": [
        "packages/flags",
        "packages/db/src/schema/flags.ts",
        "packages/db/drizzle/0002_flags.sql",
        "packages/db/drizzle/meta/0002_snapshot.json",
        "packages/orpc/src/routers/flags.ts",
        "packages/orpc/src/flags.tsx",
        "apps/web/lib/flags.ts",
        "apps/dashboard/lib/flags.ts",
        "apps/dashboard/components/beta-banner.tsx",
        "apps/dashboard/components/flags-board.tsx",
        "apps/dashboard/app/(app)/flags"
      ],
      "packages": ["@acme/flags"]
    },
    "logger": {
      "label": "Logger",
      "hint": "structured json logs with request ids and redaction in api, web and dashboard",
      "group": "ops",
      "profiles": ["everything"],
      "paths": ["packages/logger", "apps/api/src/logger.ts"],
      "packages": ["@acme/logger"]
    },
    "jobs": {
      "label": "Background jobs",
      "hint": "pg-boss queues and cron on your postgres, typed jobs, optional separate worker",
      "group": "platform",
      "profiles": ["everything"],
      "paths": [
        "packages/jobs",
        "apps/api/src/jobs.ts",
        "apps/api/src/worker.ts",
        "packages/orpc/src/routers/jobs.ts"
      ],
      "packages": ["@acme/jobs", "pg-boss"],
      "scripts": { "dev:worker": "bun --watch --env-file=.env apps/api/src/worker.ts" }
    },
    "trigger": {
      "label": "Jobs on trigger.dev",
      "hint": "run the jobs on trigger.dev (cloud or self-hosted) instead of pg-boss, same typed jobs",
      "group": "platform",
      "profiles": ["everything"],
      "requires": ["jobs"],
      "paths": [
        "packages/jobs/src/trigger.ts",
        "packages/jobs/src/trigger.test.ts",
        "packages/jobs/src/trigger",
        "apps/api/src/trigger.ts",
        "packages/jobs/trigger.config.ts"
      ],
      "packages": ["@trigger.dev/sdk", "trigger.dev"],
      "keys": [
        { "env": "TRIGGER_SECRET_KEY", "label": "trigger.dev secret key", "url": "https://cloud.trigger.dev" }
      ],
      "scripts": {
        "trigger:dev": "pnpm --filter @acme/jobs exec trigger dev",
        "trigger:deploy": "pnpm --filter @acme/jobs exec trigger deploy"
      }
    },
    "billing": {
      "label": "Billing",
      "hint": "subscriptions with Stripe or Polar: checkout, customer portal, plan entitlements, webhooks",
      "group": "product",
      "profiles": ["everything"],
      "requires": ["webhooks"],
      "paths": [
        "packages/billing",
        "packages/db/src/schema/billing.ts",
        "packages/db/drizzle/0003_billing.sql",
        "packages/db/drizzle/meta/0003_snapshot.json",
        "packages/orpc/src/routers/billing.ts",
        "apps/dashboard/components/billing-actions.tsx",
        "apps/dashboard/app/(app)/billing"
      ],
      "packages": ["@acme/billing"],
      "keys": [
        { "env": "STRIPE_SECRET_KEY", "label": "Stripe secret key", "url": "https://dashboard.stripe.com/apikeys" },
        { "env": "POLAR_ACCESS_TOKEN", "label": "Polar access token", "url": "https://polar.sh/settings" }
      ]
    },
    "orgs": {
      "label": "Organizations",
      "hint": "teams with roles and email invites on the better-auth organization plugin, notes scoped to the active organization",
      "group": "product",
      "profiles": ["everything"],
      "paths": [
        "packages/auth/src/orgs.ts",
        "packages/db/src/schema/orgs.ts",
        "packages/db/drizzle/0004_orgs.sql",
        "packages/db/drizzle/meta/0004_snapshot.json",
        "packages/orpc/src/lib/org.ts",
        "apps/dashboard/components/team-board.tsx",
        "apps/dashboard/app/(app)/team",
        "apps/dashboard/app/(app)/accept-invitation"
      ],
      "packages": []
    },
    "audit-log": {
      "label": "Audit log",
      "hint": "append-only record of who did what, with an admin viewer and a helper for your procedures",
      "group": "platform",
      "profiles": ["everything"],
      "paths": [
        "packages/db/src/schema/audit.ts",
        "packages/db/drizzle/0005_audit.sql",
        "packages/db/drizzle/meta/0005_snapshot.json",
        "packages/orpc/src/lib/audit.ts",
        "packages/orpc/src/routers/audit.ts",
        "apps/dashboard/app/(app)/audit-log"
      ],
      "packages": []
    },
    "i18n": {
      "label": "Internationalization",
      "hint": "next-intl in web and dashboard, english and french, locale switcher, hreflang in the sitemap",
      "group": "product",
      "profiles": ["everything"],
      "paths": ["packages/i18n", "apps/web/i18n", "apps/web/proxy.ts", "apps/dashboard/i18n"],
      "packages": ["@acme/i18n", "next-intl"]
    },
    "e2e": {
      "label": "End-to-end tests",
      "hint": "playwright smoke test of web, dashboard and api, plus its workflow",
      "group": "platform",
      "profiles": ["everything"],
      "paths": ["apps/e2e", ".github/workflows/e2e.yml"],
      "packages": ["@playwright/test"],
      "scripts": { "test:e2e": "pnpm --filter e2e run e2e" }
    }
  }
}
