{
  "$comment": "Read by the findplate cli: what each optional module owns. Code inside `@findplate:<module>` ... `@end` markers is removed when the module is off.",
  "name": "acme",
  "scope": "@acme",
  "skills": [
    {
      "source": "vercel-labs/agent-skills",
      "skills": ["vercel-react-best-practices", "vercel-composition-patterns", "web-design-guidelines"]
    },
    { "source": "shadcn/ui", "skills": ["shadcn"] },
    { "source": "vercel-labs/openreview", "skills": ["next-best-practices"] },
    { "source": "vercel/turborepo", "skills": ["turborepo"] },
    { "source": "better-auth/skills", "skills": ["better-auth-best-practices"] },
    { "source": "vercel-labs/skills", "skills": ["find-skills"] }
  ],
  "groups": {
    "product": "Product pages",
    "platform": "Platform",
    "notifications": "Notifications",
    "analytics": "Analytics",
    "ops": "Observability and secrets"
  },
  "modules": {
    "storage": {
      "label": "File storage",
      "hint": "uploads to any S3 API (Garage, R2, AWS, MinIO)",
      "group": "platform",
      "profiles": ["standard", "everything"],
      "paths": ["packages/storage"],
      "packages": ["@acme/storage"]
    },
    "whatsapp": {
      "label": "WhatsApp",
      "hint": "notify() through Kapso template messages",
      "group": "notifications",
      "profiles": ["everything"],
      "paths": ["packages/whatsapp", "packages/orpc/src/routers/whatsapp.ts"],
      "packages": ["@acme/whatsapp", "@kapso/whatsapp-cloud-api"],
      "keys": [{ "env": "KAPSO_API_KEY", "label": "Kapso API key", "url": "https://app.kapso.ai" }]
    },
    "webhooks": {
      "label": "Webhooks",
      "hint": "signature checks for inbound webhooks (hmac, svix, secret header)",
      "group": "platform",
      "profiles": ["everything"],
      "paths": ["packages/webhooks"],
      "packages": ["@acme/webhooks"]
    },
    "telegram": {
      "label": "Telegram bot",
      "hint": "notify() to a chat, webhook route and setup command",
      "group": "notifications",
      "profiles": ["everything"],
      "requires": ["webhooks"],
      "paths": ["packages/telegram", "packages/orpc/src/routers/telegram.ts"],
      "packages": ["@acme/telegram"],
      "keys": [
        {
          "env": "TELEGRAM_BOT_TOKEN",
          "label": "Telegram bot token (from @BotFather)",
          "url": "https://t.me/BotFather"
        }
      ]
    },
    "email": {
      "label": "Email",
      "hint": "react-email templates sent through email-sdk and Resend",
      "group": "notifications",
      "profiles": ["everything"],
      "paths": ["packages/email", "packages/orpc/src/routers/email.ts"],
      "packages": ["@acme/email", "@opencoredev/email-sdk", "@react-email/render"],
      "keys": [{ "env": "RESEND_API_KEY", "label": "Resend API key", "url": "https://resend.com/api-keys" }]
    },
    "docs": {
      "label": "Docs site",
      "hint": "fumadocs on Next, with pages about your project",
      "group": "product",
      "profiles": ["standard", "everything"],
      "paths": ["apps/docs"],
      "packages": ["fumadocs-core", "fumadocs-mdx", "fumadocs-ui", "@types/mdx"]
    },
    "ai": {
      "label": "AI",
      "hint": "Vercel AI SDK with Groq, OpenAI or Anthropic",
      "group": "platform",
      "profiles": ["standard", "everything"],
      "paths": ["packages/ai", "apps/dashboard/components/summarize-button.tsx"],
      "packages": ["@acme/ai", "ai", "@ai-sdk/anthropic", "@ai-sdk/groq", "@ai-sdk/openai"],
      "skills": [{ "source": "vercel/ai", "skills": ["ai-sdk"] }],
      "keys": [
        { "env": "GROQ_API_KEY", "label": "Groq API key", "url": "https://console.groq.com/keys" },
        { "env": "OPENAI_API_KEY", "label": "OpenAI API key", "url": "https://platform.openai.com/api-keys" },
        {
          "env": "ANTHROPIC_API_KEY",
          "label": "Anthropic API key",
          "url": "https://console.anthropic.com/settings/keys"
        }
      ]
    },
    "umami": {
      "label": "Umami analytics",
      "hint": "self-hosted web analytics script in web and dashboard",
      "group": "analytics",
      "profiles": [],
      "server": { "label": "a self-hosted Umami server", "url": "https://umami.is/docs/install" },
      "paths": ["apps/web/components/umami.tsx", "apps/dashboard/components/umami.tsx"],
      "packages": [],
      "keys": [{ "env": "NEXT_PUBLIC_UMAMI_WEBSITE_ID", "label": "Umami website id", "url": "https://umami.is/docs/add-a-website" }]
    },
    "openobserve": {
      "label": "OpenObserve",
      "hint": "self-hosted otel traces from the api",
      "group": "ops",
      "profiles": [],
      "server": { "label": "a self-hosted OpenObserve server", "url": "https://openobserve.ai/docs/quickstart/" },
      "paths": ["apps/api/src/openobserve.ts"],
      "packages": ["@opentelemetry/api", "@opentelemetry/sdk-node", "@opentelemetry/exporter-trace-otlp-http"]
    },
    "glitchtip": {
      "label": "GlitchTip",
      "hint": "self-hosted error tracking (sentry sdk) in api, web and dashboard",
      "group": "ops",
      "profiles": [],
      "server": { "label": "a self-hosted GlitchTip server", "url": "https://glitchtip.com/documentation/install" },
      "paths": [
        "apps/web/instrumentation.ts",
        "apps/web/instrumentation-client.ts",
        "apps/dashboard/instrumentation.ts",
        "apps/dashboard/instrumentation-client.ts"
      ],
      "packages": ["@sentry/bun", "@sentry/nextjs"],
      "keys": [{ "env": "GLITCHTIP_DSN", "label": "GlitchTip DSN", "url": "https://glitchtip.com/documentation/install" }]
    },
    "infisical": {
      "label": "Infisical",
      "hint": "self-hosted secrets, dev scripts run through the infisical cli",
      "group": "ops",
      "profiles": [],
      "server": { "label": "a self-hosted Infisical server", "url": "https://infisical.com/docs/self-hosting/overview" },
      "paths": [".infisical.json"],
      "packages": [],
      "scripts": { "dev:secrets": "infisical run --env=dev -- turbo dev" }
    },
    "langfuse": {
      "label": "Langfuse",
      "hint": "self-hosted LLM tracing for the ai module",
      "group": "ops",
      "profiles": [],
      "server": { "label": "a self-hosted Langfuse server", "url": "https://langfuse.com/self-hosting" },
      "requires": ["ai"],
      "paths": ["apps/api/src/langfuse.ts"],
      "packages": ["@langfuse/otel", "@langfuse/vercel-ai-sdk", "@opentelemetry/sdk-node"],
      "keys": [
        { "env": "LANGFUSE_PUBLIC_KEY", "label": "Langfuse public key", "url": "https://langfuse.com/docs/get-started" },
        { "env": "LANGFUSE_SECRET_KEY", "label": "Langfuse secret key", "url": "https://langfuse.com/docs/get-started" }
      ]
    },
    "waitlist": {
      "label": "Waitlist",
      "hint": "email signup on the landing page, list in the dashboard",
      "group": "product",
      "profiles": ["everything"],
      "paths": [
        "packages/db/src/schema/waitlist.ts",
        "packages/db/drizzle/0001_waitlist.sql",
        "packages/db/drizzle/meta/0001_snapshot.json",
        "packages/orpc/src/routers/waitlist.ts",
        "apps/web/components/waitlist-form.tsx",
        "apps/dashboard/app/(app)/waitlist"
      ],
      "packages": []
    },
    "roadmap": {
      "label": "Roadmap page",
      "hint": "public /roadmap built from the repo's GitHub milestones",
      "group": "product",
      "profiles": ["everything"],
      "paths": [
        "packages/orpc/src/routers/roadmap.ts",
        "packages/orpc/src/lib/roadmap.ts",
        "packages/orpc/src/lib/roadmap.test.ts",
        "apps/web/app/roadmap"
      ],
      "packages": []
    },
    "status": {
      "label": "Status page",
      "hint": "public /status with live uptime checks of every service",
      "group": "product",
      "profiles": ["everything"],
      "paths": ["packages/orpc/src/routers/status.ts", "apps/web/app/status"],
      "packages": []
    },
    "databuddy": {
      "label": "Databuddy analytics",
      "hint": "privacy first, cookieless analytics on web and dashboard",
      "group": "analytics",
      "profiles": ["everything"],
      "paths": ["apps/web/components/analytics.tsx", "apps/dashboard/components/analytics.tsx"],
      "packages": ["@databuddy/sdk"],
      "keys": [
        { "env": "NEXT_PUBLIC_DATABUDDY_CLIENT_ID", "label": "Databuddy client id", "url": "https://app.databuddy.cc" }
      ]
    },
    "rate-limit": {
      "label": "Rate limiting",
      "hint": "per route and ip limits on the api, in memory or on Upstash Redis",
      "group": "platform",
      "profiles": ["standard", "everything"],
      "paths": ["apps/api/src/rate-limit.ts", "packages/orpc/src/lib/rate-limit.ts", "packages/orpc/src/lib/rate-limit.test.ts"],
      "packages": []
    }
  }
}
